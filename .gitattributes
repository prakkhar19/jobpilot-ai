# Keep LF line endings everywhere so a Windows clone still builds (shell scripts run inside Linux
# containers and break with CRLF). Windows launchers keep CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary
