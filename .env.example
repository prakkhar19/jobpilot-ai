# ---------------------------------------------------------------------------------------------
# JobPilot AI configuration. Copy to .env and adjust. See docs/ENVIRONMENT.md for every option.
# Never commit your .env file.
# ---------------------------------------------------------------------------------------------

# Database credentials (internal Docker network only). CHANGE THE PASSWORD for any non-local install:
#   openssl rand -base64 24      (or run: make init-env)
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=jobpilot

# Secret for sessions and encryption of stored API keys (min 32 chars).
# Leave empty to auto-generate one on first start (stored in the app data volume).
# If you set it, keep it safe: changing it makes stored API keys unreadable.
APP_SECRET_KEY=

# Where the dashboard is published. Default: only this machine (127.0.0.1).
# On a server keep 127.0.0.1 and put an HTTPS reverse proxy in front (docs/DEPLOYMENT.md).
JOBPILOT_BIND=127.0.0.1
JOBPILOT_PORT=8080
# The URL users open in the browser (used in password-reset links).
PUBLIC_BASE_URL=http://localhost:8080
# Set to true when served over HTTPS (secure cookies + HSTS).
COOKIE_SECURE=false

ENVIRONMENT=production
LOG_LEVEL=INFO

# Accounts: SINGLE_USER_MODE=true closes registration after the first account (personal installs).
ALLOW_REGISTRATION=true
SINGLE_USER_MODE=false

# Sandbox job board + mock employer portal (fictional, clearly labelled) for trying the full workflow.
# The sandbox never contacts a real employer.
DEMO_MODE=false

# Allow admins (or single-user installs) to use AI endpoints on private networks, e.g. Ollama at
# http://host.docker.internal:11434/v1 (Docker Desktop) or a LAN address.
ALLOW_PRIVATE_LLM_ENDPOINTS=true

# Optional SMTP for password-reset emails. Without it, an admin runs: make reset-password EMAIL=...
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

MAX_UPLOAD_MB=10
DATA_RETENTION_DAYS_LOGS=90
WORKER_CONCURRENCY=2
